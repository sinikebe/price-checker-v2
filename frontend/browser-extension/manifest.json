{
  "manifest_version": 3,
  "name": "Price Checker — relevés Carrefour",
  "version": "0.3.0",
  "description": "Lit le prix des produits d’un panier sur carrefour.fr, avec votre session et votre magasin, et les enregistre dans votre instance Price Checker.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.carrefour.fr/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.carrefour.fr/*"
      ],
      "js": [
        "carrefour-parse.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Price Checker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
